---
import { micromark } from "micromark";

import Section from "~/components/Section.astro";

// const about = `Seasoned frontend developer with 8+ years of experience, specializing in React and React Native. Skilled at building accessible, high-performing web and mobile applications. Proficient in backend development and DevOps, contributing to software architecture, system design, DevOps management and tooling.

// As a collaborative team member, I have extensive experience working in Agile environments, contributing to software design decisions, and proactively researching new technologies to solve complex problems. I'm passionate about local-first approaches and their ability to create more resilient, privacy-preserving, and user-centric applications.`;
const about = `Fullstack Software Engineer with __+8 years of experience__ specializing in __React__, __React Native__, and __TypeScript__. Strong background in __full-stack development__, __system architecture__, and __cloud infrastructure__ (AWS, Azure, Docker). 

Passionate about building __local-first__, __scalable__, __high-performance__, and __accessible__ web and mobile applications, and optimizing frontend and backend systems for __maintainability__ and __efficiency__. `

---

<Section class="about" title="tl;dr">
  <span is:raw set:html={micromark(about)} />
</Section>

<style is:global>
  .about {
    grid-area: about;
    padding: 1.5em 1em;
    color: var(--secondary);
    font-family: "Raleway", serif;
    /* line-height: 1.4; */
    line-height: 1.2em;
    letter-spacing: 0.05em;
  }

  .about h2 {
    display: inline !important;
    font-size: 1em;
  }

  .about:hover p > * {
    color: var(--strong);
  }

  .about span {
    font-size: 0.8em;
  }

  .about span p {
    margin-top: calc(1em / 0.9);
  }

  .about span p:first-child {
    display: inline;
    margin-top: 0;
  }

  @media screen and (min-width: 426px) {
    .about {
      padding: 1.5em 2em;
    }
  }

  @media screen and (min-width: 768px), print {
    .about {
      padding: 2em;
      background: var(--light);
    }
  }
</style>
